PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/lifeline_connect?retryWrites=true&w=majority
LOCAL_MONGO_URI=mongodb://127.0.0.1:27017/lifeline_connect
JWT_SECRET=your_jwt_secret_key

# ============================================================
# Twilio SMS Configuration for Emergency Contact Alerts
# ============================================================
# Sign up at https://console.twilio.com to get your credentials
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx
DEFAULT_COUNTRY_CODE=+91
